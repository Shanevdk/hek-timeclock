# Copy this file to ".env" (locally) or set these as environment variables on your host.

# ---- Cloud database (REQUIRED) --------------------------------------------
# Paste the MongoDB connection string from your provider (e.g. MongoDB Atlas).
# The app stores ALL data here — nothing on the server.
# Example: mongodb+srv://user:password@cluster.mongodb.net/?appName=yourapp
DATABASE_URL=

# Name of the database to use inside the cluster (created automatically).
# DB_NAME=hektimeclock

# How much room the plan allows, in MB — what "storage left" on the App health
# page is measured against. A shared Atlas tier does not report a disk, so it
# has to be told: the free M0 tier is 512, M2 is 2048, M5 is 5120. A server
# with a real disk reports its own size and this is ignored.
# DB_STORAGE_LIMIT_MB=512

# ---- Admin access ----------------------------------------------------------
# Email admins type to sign in to the dashboard.
ADMIN_EMAIL=admin@hekfencing.com

# Password admins type to reach the dashboard — at least 8 characters. Only used
# to create the admin login the first time the app starts; after that it is
# changed from the dashboard (the gear menu → Your login).
ADMIN_PASSWORD=

# The built-in "dev" account (a limited admin for whoever maintains the app).
# It only exists when DEV_PASSWORD is set — at least 12 characters. Changing
# DEV_PASSWORD and restarting changes the dev's password.
# DEV_EMAIL=dev@hek-fencing.com
# DEV_PASSWORD=

# Timezone used to decide when a workday ends (for detecting missed clock-outs).
# Use an IANA name, e.g. America/New_York, America/Toronto, America/Chicago.
TIMEZONE=America/New_York

# REQUIRED. Signs the login cookie — anyone who knows it can sign in as anyone,
# so it must be long, random and secret. The app refuses to start without one.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# URL path for the admin dashboard. Admins sign in on the main page ("/") and are
# redirected here automatically, so it isn't linked from the employee page.
ADMIN_PATH=/admin

# Port the server listens on (most hosts set this for you).
PORT=3000

# ---- QuickBooks payroll sync (OPTIONAL) ------------------------------------
# Pushes each pay period's hours into QuickBooks as time entries, so payroll is
# reviewed and run there with the numbers already filled in. Intuit has no
# public API for running a payroll or sending direct deposit, so this never pays
# anyone — someone still clicks "Run payroll" in QuickBooks.
#
# Leave these blank and the QuickBooks tab simply explains what's missing.
#
# These four are OPTIONAL. The easier route is to paste the keys into the
# QuickBooks tab in the dashboard, where they're stored encrypted and can be
# rotated without a redeploy. Anything set there overrides the matching variable
# here, field by field; these act as defaults for a deployment set up that way.
#
# Create an app at https://developer.intuit.com -> My Apps, then copy its
# "Keys & credentials" for the environment you're pointing at.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# "sandbox" (default, for testing against a fake company) or "production".
QBO_ENVIRONMENT=sandbox

# Must match a Redirect URI listed on the Intuit app EXACTLY, including https
# and no trailing slash. Locally that means http://localhost:3000/api/quickbooks/callback
QBO_REDIRECT_URI=

# Shared secret for the scheduled sync. On Vercel, setting this makes Vercel
# Cron send "Authorization: Bearer <value>"; without it the scheduled endpoint
# stays closed, because anything that can reach that URL can write to the books.
# Not needed on Netlify (its scheduler calls the function directly).
CRON_SECRET=

# ---- AI inbox agent (OPTIONAL) ---------------------------------------------
# Reads the company mailbox, finds emails asking about fencing, and drafts an
# estimate from your rate book for someone to review. It never replies to
# anyone and never creates a quote on its own.
#
# API key from https://platform.claude.com. Each email read costs a fraction of
# a cent; the dashboard caps how many are read per scan.
ANTHROPIC_API_KEY=

# The mailbox host/user/password are entered in the dashboard, not here.
#
# ---- Stored credential encryption -----------------------------------------
# Credentials the app holds on your behalf — the mail app password and the
# QuickBooks client secret — are encrypted before they are stored. The key is
# derived from SESSION_SECRET by default, so SESSION_SECRET must be a real
# random value (not the placeholder) before either can be saved.
#
# Set this to key that encryption off its own secret instead. Changing whichever
# one is in use makes already-saved credentials unreadable, and the dashboard
# asks for them again.
# Changing SESSION_SECRET changes this key too (when this is not set), and the
# saved credentials then have to be entered again. To keep them across a
# SESSION_SECRET change, set this to the OLD SESSION_SECRET first.
# CREDENTIAL_ENCRYPTION_KEY=

# --- Limits (all optional) ---------------------------------------------------
# On a host other than Netlify or Vercel: the header your proxy guarantees holds
# the visitor's address, for per-address rate limits (e.g. cf-connecting-ip).
# CLIENT_IP_HEADER=
# Public estimate page ceilings per day, all visitors together.
# STREETVIEW_DAILY_CAP=500
# ESTIMATE_REQUEST_DAILY_CAP=200
# How long a "Scan now" / manual QuickBooks sync may run, in ms (lower them on a
# host with a shorter function time limit).
# INBOX_SCAN_BUDGET_MS=45000
# QBO_SYNC_BUDGET_MS=45000
#
# Older name for the same thing, still honoured if already set.
# MAIL_ENCRYPTION_KEY=

# ---- Street View on the estimate page (OPTIONAL) ---------------------------
# Lets the 3D preview also show Google's photo of the property from the road.
# The 3D fence standing on satellite imagery needs no key and always works.
#
# Easier to paste this into the dashboard under Estimates -> Page settings,
# where it is stored encrypted. This variable is a fallback for deployments
# already set up that way.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# File attachments (job files and task attachments)
#
# Attachments are uploaded straight from the browser to an S3-compatible bucket
# and read back through short-lived signed URLs, so a 1 GB file never passes
# through a serverless function. Defaults below are for Cloudflare R2; AWS S3,
# Backblaze B2 and Supabase Storage work by changing S3_ENDPOINT (and setting
# S3_REGION for AWS).
#
# Leave these blank when running locally and files are kept on disk under
# ./.storage instead — handy for development. Deployed (Netlify, Vercel,
# Render, Railway, Fly, or NODE_ENV=production) with no bucket, uploads are
# refused rather than written to a disk that is wiped on the next deploy.
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing. Required by R2/B2/Supabase; harmless on AWS.
S3_FORCE_PATH_STYLE=true
# Largest attachment accepted, in bytes. Default 1 GB.
ATTACH_MAX_BYTES=1073741824
# Force a driver: "s3" or "local". Normally left unset — the presence of
# S3_BUCKET decides. "local" on a deployed host is only safe with a persistent
# disk mounted at STORAGE_DIR.
STORAGE_DRIVER=
